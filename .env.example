# Set to true to show Milo on the site. Off by default until the agent is ready.
NEXT_PUBLIC_ENABLE_MILO=

# Optional: better open-ended answers. Without this, a local knowledge brain still works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: email the CV during the call. Without this, emails are stored and a download is offered.
RESEND_API_KEY=
MAIL_FROM=Milo <milo@your-domain.com>

# Required to view stored emails at /leads
LEADS_ADMIN_TOKEN=change-me
